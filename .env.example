# ============================================================================
# OmniChat AI — environment variables
# ----------------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in the four REQUIRED values below.
# 3. Leave everything else as-is until you need it.
#
# One app, one env file. The Express backend was removed — everything it did
# now runs inside the Next.js app.
#
# .env.local is gitignored. Never commit it, never paste it anywhere public.
# ============================================================================


# ---- REQUIRED: Supabase -----------------------------------------------------
# Supabase dashboard -> Project Settings -> API

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon public" key (newer projects call it "publishable", sb_publishable_...)
# Safe to expose to the browser — RLS is what actually protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# "service_role" key (newer projects call it "secret", sb_secret_...).
# Click Reveal to see it. SERVER ONLY — bypasses all security rules.
# Never expose this to a browser, a chat window, or a git commit.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...


# ---- REQUIRED: Gemini AI ----------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Optional — override the model if your key can't reach the default.
# GEMINI_MODEL=gemini-2.5-flash


# ---- Local URLs (defaults are correct for local development) ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ============================================================================
# OPTIONAL — everything below is only needed for live channels and payments.
# The app runs fine locally without any of it.
# ============================================================================

# ---- Stripe (only needed to take real payments) -----------------------------
# https://dashboard.stripe.com/test/apikeys — use the TEST keys while building
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- WhatsApp Cloud API (needs a verified Meta Business account) ------------
# A password you invent — you type the same string into Meta's webhook setup
# WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
# From Meta -> App Settings -> Basic -> App Secret. Used to prove that
# incoming webhooks really came from Meta.
# WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_DEFAULT_BUSINESS_ID=

# ---- Instagram / Messenger --------------------------------------------------
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_DEFAULT_BUSINESS_ID=
# MESSENGER_VERIFY_TOKEN=
# MESSENGER_APP_SECRET=
# MESSENGER_DEFAULT_BUSINESS_ID=

# ---- Campaign scheduler -----------------------------------------------------
# Shared secret your cron job sends as: Authorization: Bearer <this>
# CAMPAIGN_CRON_SECRET=pick-any-long-random-string
